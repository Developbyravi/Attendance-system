# ==============================================================================
# SmartAttend AIoT Backend2 — Environment Configuration Template
# ==============================================================================

# Application Environment (development, production, testing)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8002
DEBUG=true

# Database Configuration (Mandatory: SQLite fallback for local development, PostgreSQL for production)
# Local SQLite default: sqlite:///./smartattend.db
DATABASE_URL=sqlite:///./smartattend.db

# Optional Supabase Integration (Leave blank to use local SQLite + local filesystem storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Security & Authentication (Mandatory in production; fallback development secret provided for testing)
JWT_SECRET=smartattend-dev-insecure-secret-key-change-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Face Detection & Recognition Pipeline
# Model path relative to backend2 root or absolute
SCRFD_MODEL_PATH=weights/scrfd_10g_bnkps.onnx
FACE_DETECTOR_MODEL=InsightFace SCRFD-10G
FACE_RECOGNITION_MODEL=ArcFace-MobileFaceNet
FACE_DETECTION_THRESHOLD=0.50
FACE_MATCH_THRESHOLD=0.70
FACE_AMBIGUITY_THRESHOLD=0.08
EMBEDDING_DIMENSION=512

# Inference Hardware ('cpu' or 'cuda')
INFERENCE_DEVICE=cpu

# High-Resolution Classroom Inference Settings
ENABLE_TILED_INFERENCE=true
TILE_SIZE=640
TILE_OVERLAP=0.25

# Storage Configuration
STORAGE_DRIVER=local
STORAGE_BUCKET=smartattend-storage
UPLOAD_DIR=./uploads

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8002

