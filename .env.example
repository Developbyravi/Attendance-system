# ==============================================================================
# SmartAttend — Global Environment Configuration Template
# Copy this file to .env.local (frontend) or deployment/.env (backend)
# ==============================================================================

# ── Frontend Configuration (Next.js 15) ──
# Base URL for FastAPI backend endpoints (include /api)
NEXT_PUBLIC_API_URL="http://localhost:8002/api"

# Supabase Auth Configuration (Client publishable keys only)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# ── Backend Configuration (FastAPI 2.0.0) ──
APP_NAME="SmartAttend AIoT Backend2"
APP_ENV="development"
APP_PORT=8002

# Database Connection (SQLite local development fallback)
DATABASE_URL="sqlite:///./smartattend.db"
# For production PostgreSQL / Supabase, use:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# JWT Token Security (Generate a secure 64-char random key in production)
SECRET_KEY="replace-this-with-a-secure-random-64-character-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://smartattend.vercel.app"

# Storage Subsystem Driver ("local" or "supabase")
STORAGE_DRIVER="local"
UPLOAD_DIR="uploads"

# Computer Vision & Deep Learning Thresholds
SCRFD_MODEL_PATH="weights/scrfd_10g_bnkps.onnx"
SCRFD_DEVICE="cpu"
FACE_RECOGNITION_THRESHOLD=0.70
FACE_AMBIGUITY_THRESHOLD=0.08

# Edge IoT Hardware Device Secret Key
DEVICE_API_KEY="replace-with-rotated-esp8266-device-key-2026"
