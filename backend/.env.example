# AIoT SmartAttend — Backend Environment Configuration Example
# Copy this file to .env and configure your environment

APP_NAME="AIoT SmartAttend Backend"
DATABASE_URL="sqlite:///./smartattend.db"

# Supabase Integration (Optional/Production)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_STORAGE_BUCKET_CLASSROOM="classroom-images"
SUPABASE_STORAGE_BUCKET_STUDENTS="student-enrollments"

# Security & Secret Keys
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEVICE_API_KEY="replace-with-esp8266-hardware-secret-key"

# Face Detector & Vision Model Configuration
DETECTOR_BACKEND="SCRFD"
SCRFD_MODEL_PATH="weights/scrfd_10g_bnkps.onnx"
SCRFD_CONFIDENCE_THRESHOLD=0.40
SCRFD_NMS_THRESHOLD=0.40
SCRFD_INPUT_SIZE=640
SCRFD_MIN_FACE_SIZE=10
SCRFD_ENABLE_TILED_INFERENCE=True
SCRFD_DEVICE="cpu"

# YOLOv11n-face (Preserved for benchmarking & fallback)
YOLO_MODEL_PATH="weights/yolov11n-face.pt"
MIN_FACE_CONFIDENCE=0.85
FACE_RECOGNITION_THRESHOLD=0.70
EMBEDDING_DIMENSION=512

# Institutional Settings
INSTITUTION_TIMEZONE="Asia/Kolkata"
MAX_UPLOAD_SIZE_MB=10
